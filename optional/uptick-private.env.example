# Copy this file to 4 System/Automation/.uptick-private.env in your vault.
# It is local-only and must never be committed.
UPTICK_CALENDAR_ID=
UPTICK_CALENDAR_MATCH=icloud,exchange,office365,outlook
UPTICK_REMINDER_LIST_ID=
UPTICK_OWNER_PATTERN=\\b(you|your|assigned to you)\\b
UPTICK_ASSIGNEE_MARKERS=you,me,owner,assignee
# Relative paths are resolved from the vault root.
UPTICK_SERIES_RULES_FILE=4 System/Automation/.uptick-series-rules.json
